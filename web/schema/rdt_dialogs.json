{
 "format": "rdt_dialogs 1",
 "about": "Write schema/rdt_dialogs.json (copied to web/schema/): the stock CPS dialogs that exist only in the .rdt (no CSV), as",
 "undecoded": {
  "both": [
   "Alarm Setting > Analog > Emergency ID (list content depends on the signalling tables)",
   "Alarm Setting > ENI Type list texts (the value is stored raw)",
   "5Tone Setting: Stop Code, Stop Time (header bytes 0x23-0x25 are not tied to one field); the Function Name of an information code (the string after the ID is kept as it is)",
   "2Tone Setting > Decode tab",
   "DTMF Setting > Special Call",
   "Encode ID tables (CSV)"
  ],
  "D890UV": [
   "Alarm Setting > QDC1200 Group ID: the stock D890UV CPS shows the bytes at C+0x56 but saves to C+0x4F, so it does not survive its own save (the frame is greyed out there)"
  ],
  "D168UV": [
   "Talk Alias > Custom Text: the V1.07 dialog shows no text field when it is chosen; where (or if) a text is kept is not known",
   "QDC1200 Setting: Max ACK wait, Sync headers, Pretime, Try times, Side Tone"
  ],
  "both_live": [
   "Local Information: the stock CPS opens the COM port for it; it is live radio data, not in the .rdt"
  ]
 },
